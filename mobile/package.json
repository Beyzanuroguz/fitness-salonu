{
  "name": "formclub-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "FORM CLUB iOS/Android Capacitor kabuğu. Backend bu pakete dahil değildir.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "configure": "node scripts/configure.js",
    "add:ios": "npm run configure && cap add ios",
    "add:android": "npm run configure && cap add android",
    "sync": "npm run configure && cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "doctor": "cap doctor",
    "test": "node --test test/"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2"
  }
}
