{
  "id": "/",
  "name": "FORM CLUB",
  "short_name": "FORM CLUB",
  "description": "Üye QR girişi, QR okutma, bildirim merkezi ve eğitmen performansı.",
  "lang": "tr",
  "dir": "ltr",
  "start_url": "/index.html",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#0b100d",
  "theme_color": "#0b100d",
  "categories": [
    "health",
    "fitness",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/v9/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/v9/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/v9/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/v9/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "QR giriş kodum",
      "short_name": "QR kodum",
      "url": "/#entry",
      "icons": [
        {
          "src": "/v9/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "QR okut",
      "short_name": "QR okut",
      "url": "/#scan",
      "icons": [
        {
          "src": "/v9/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Bildirimler",
      "url": "/#notifications",
      "icons": [
        {
          "src": "/v9/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}